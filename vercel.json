{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "routes": [
    {
      "src": "/area",
      "headers": { "Location": "/areas" },
      "status": 301
    },
    {
      "src": "/api/trpc/(.*)",
      "dest": "/api/trpc"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
