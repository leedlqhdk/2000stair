{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "vite build && tsx scripts/prerender-seo.ts",
  "headers": [
    {
      "source": "/card/2000stair.vcf",
      "headers": [
        { "key": "Content-Type", "value": "text/vcard; charset=utf-8" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "card.2000stair.kr" }],
      "destination": "/card/",
      "permanent": false
    },
    { "source": "/area", "destination": "/areas", "permanent": true },
    { "source": "/area/", "destination": "/areas", "permanent": true },
    { "source": "/blog", "destination": "/records", "permanent": true },
    { "source": "/blog/", "destination": "/records", "permanent": true },
    { "source": "/work", "destination": "/records", "permanent": true },
    { "source": "/work/", "destination": "/records", "permanent": true },
    { "source": "/area/Majang", "destination": "/area/majang", "permanent": true },
    { "source": "/area/Majang/", "destination": "/area/majang", "permanent": true },
    { "source": "/area/downtown", "destination": "/areas", "permanent": true },
    { "source": "/area/downtown/", "destination": "/areas", "permanent": true },
    { "source": "/area/songjeong", "destination": "/area/jungni", "permanent": true },
    { "source": "/area/songjeong/", "destination": "/area/jungni", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/trpc/:path*", "destination": "/api/trpc" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/rss.xml", "destination": "/api/rss" },
    { "source": "/blog/:id(\\d+)", "destination": "/api/blog-og?id=:id" },
    { "source": "/work/:slug", "destination": "/api/work-og?slug=:slug" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
