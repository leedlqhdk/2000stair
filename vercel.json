{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "redirects": [
    { "source": "/area", "destination": "/areas", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/trpc/:path*", "destination": "/api/trpc" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
